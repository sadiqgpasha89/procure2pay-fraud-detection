# Copy to .env. Every value has a working default; only change what you need.

# ── data / auth ─────────────────────────────────────────────
DATA_DIR=data/runtime
SERVICE_TOKEN=                 # empty = auth off (local dev only). Any shared environment: set a long random value.

# ── Tier 3 LLM:  offline | ollama | vertex ──────────────────
LLM_PROVIDER=offline           # offline = deterministic reference model (no key, no GPU) · ollama = open weights · vertex = Gemini
OLLAMA_MODEL=ollama_chat/gemma3:12b
OLLAMA_API_BASE=http://127.0.0.1:11434
GEMINI_MODEL=gemini-3.5-flash
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# ── RAG embeddings:  lexical | ollama | vertex ───────────────
EMBEDDING_PROVIDER=lexical     # lexical = TF-IDF (free, offline) · ollama = nomic-embed-text · vertex = text-embedding-005

# ── decision policy ──────────────────────────────────────────
TAU_1=0.35
TAU_2=0.70
BANK_FREEZE_HOURS=72
PO_VARIANCE_TOLERANCE=0.10
DUAL_APPROVAL_LIMIT=50000

# ── audit sink:  file | gcs (+ optional BigQuery mirror) ──────
AUDIT_SINK=file
AUDIT_GCS_BUCKET=
AUDIT_BQ_TABLE=                # project.dataset.table

# ── production state stores (SQLAlchemy URLs; default = local SQLite) ──
# CASE_DB_URL=postgresql+psycopg:///p2p?host=/cloudsql/PROJECT:REGION:INSTANCE
# DECISION_DB_URL=postgresql+psycopg:///p2p?host=/cloudsql/PROJECT:REGION:INSTANCE
